{
  "identifier": "default",
  "description": "主窗口的全部能力：读写自己的数据目录、访问三个公开数据源、把外链交给系统浏览器、用系统对话框选一个文件夹。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "fs:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [{ "path": "$APPDATA/**" }]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.github.com/**" },
        { "url": "https://cdn.jsdelivr.net/**" },
        { "url": "https://unpkg.com/**" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://**" }]
    },
    {
      "identifier": "dialog:allow-open",
      "description": "只用于「修改数据目录」：把选哪个文件夹的决定交给用户自己，选完之后能读写哪里仍由 $APPDATA/** 决定。"
    }
  ]
}
