{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "万年历",
  "version": "../package.json",
  "identifier": "com.tyme.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "万年历",
        "width": 1240,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": [246, 246, 244, 255]
      }
    ],
    "security": {
      "csp": null,
      "freezePrototype": false
    },
    "appDirectoriesOverride": {
      "data": "$DATA/万年历"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
