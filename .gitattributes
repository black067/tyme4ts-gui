# Store LF in the repository AND check out LF, on every platform.
#
# `eol=lf` matters: Prettier is configured with `endOfLine: "lf"`, so without it
# a Windows checkout produces CRLF that Prettier then rewrites to LF, leaving 90
# files permanently "modified" (identical after normalisation, so `git diff` is
# empty but `git status` never goes clean).
* text=auto eol=lf

*.ts    text
*.tsx   text
*.js    text
*.mjs   text
*.cjs   text
*.json  text
*.css   text
*.html  text
*.md    text
*.yml   text
*.yaml  text

*.png   binary
*.jpg   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.exe   binary

# Keep vendored submodule content out of language statistics/diff noise.
vendor/** -diff
