{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试主进程（dev）",
      "type": "node",
      "request": "attach",
      "port": 5858,
      "cwd": "${workspaceFolder}",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/out/main/**/*.js"],
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "preLaunchTask": "dev:inspect",
      "timeout": 30000
    },
    {
      "name": "调试渲染进程（dev）",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/src/renderer",
      "sourceMaps": true,
      "preLaunchTask": "dev:remote-debug",
      "timeout": 30000
    },
    {
      "name": "调试主进程（仅附加，不启动）",
      "type": "node",
      "request": "attach",
      "port": 5858,
      "cwd": "${workspaceFolder}",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/out/main/**/*.js"],
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
